# PayLinkBridge - Secure Bank Transfer System
# Environment Configuration

# Server Configuration
PORT=4000
ADMIN_PASS=change_me_to_secure_password

# Encryption Configuration (REQUIRED)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_SECRET_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
ENCRYPTION_KEY_VERSION=1
DATABASE_ENCRYPTION=enabled

# Bank Account Configuration (REQUIRED)
BANK_ACCOUNT_NAME=YOUR_FULL_NAME
BANK_ACCOUNT_ADDRESS=YOUR_ADDRESS
BANK_BSB=000000
BANK_ACCOUNT_NUMBER=00000000
BANK_BIC_SWIFT=YOUR_BIC_SWIFT_CODE
BANK_NAME=Commonwealth Bank of Australia

# Email Configuration (INTERNAL QUEUE - NO EXTERNAL SMTP)
ADMIN_EMAIL=admin@yourdomain.com

# Application Configuration
PAYLINK_SELF_URL=http://localhost:4000
